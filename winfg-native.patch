+                   VK_ACCESS_MEMORY_READ_BIT, VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_TRANSFER_READ_BIT);
+
+        uint32_t generations = winfg_process(eng, swapchain->cmdBuffer, srcImg, w, h);
+
+        if (generations > 0) {
