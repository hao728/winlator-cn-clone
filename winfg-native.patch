+            imgBarrier(swapchain->cmdBuffer, swapchain->genImage,
+                       VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL,
+                       0, VK_ACCESS_SHADER_WRITE_BIT);
+            winfg_generate(eng, swapchain->cmdBuffer, 0, generations,
+                           swapchain->genImage, swapchain->genView, w, h);
