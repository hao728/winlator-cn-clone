+            vulkanWrapper.vkResetCommandBuffer(swapchain->cmdBuffer, 0);
+            vulkanWrapper.vkBeginCommandBuffer(swapchain->cmdBuffer, &bi);
+            // 从 ring[curr] 恢复真实帧到 srcImg
+            winfg_restore_curr(eng, swapchain->cmdBuffer, srcImg, w, h);
+            vulkanWrapper.vkEndCommandBuffer(swapchain->cmdBuffer);
+            winfgSubmitAndWait(swapchain);
+            // 显示真实帧
+            (*swapchain->jmethods->env)->CallVoidMethod(swapchain->jmethods->env, swapchain->jmethods->obj,
+                                                        swapchain->jmethods->updateWindowContent, swapchain->windowId);
+        }
+        return;
+    }
+
+    // --- 普通 present 路径（win-fg 关闭时）---
     (*swapchain->jmethods->env)->CallVoidMethod(swapchain->jmethods->env, swapchain->jmethods->obj,
                                                 swapchain->jmethods->updateWindowContent, swapchain->windowId);
-}
\ No newline at end of file
+}
+
+// ============================================================================
+// win-fg 运行时控制（JNI 层调用）
+// ============================================================================
+
+void XWindowSwapchain_setWinFgEnabled(XWindowSwapchain* swapchain, int enabled) {
+    if (!swapchain) return;
+    swapchain->winfgEnabled = enabled ? 1 : 0;
+    if (!enabled && swapchain->winfgEngine) {
+        winfg_reset((WinFgEngine*)swapchain->winfgEngine);
+    }
+}
+
+void XWindowSwapchain_setWinFgConfig(XWindowSwapchain* swapchain, int multiplier, int model, int preset, float flowScale) {
+    if (!swapchain) return;
+    swapchain->winfgMultiplier = multiplier;
+    swapchain->winfgModel = model;
+    swapchain->winfgPreset = preset;
+    swapchain->winfgFlowScale = flowScale;
+    if (swapchain->winfgEngine) {
+        winfg_configure((WinFgEngine*)swapchain->winfgEngine, multiplier, model, preset, flowScale);
+    }
+}
+
+int XWindowSwapchain_isWinFgActive(XWindowSwapchain* swapchain) {
+    if (!swapchain || !swapchain->winfgEnabled) return 0;
+    return swapchain->winfgEngine ? winfg_valid((WinFgEngine*)swapchain->winfgEngine) : 0;
+}
diff --git a/app/src/main/cpp/winlator/winfg/winfg_bridge.cpp b/app/src/main/cpp/winlator/winfg/winfg_bridge.cpp
new file mode 100644
index 0000000..a771553
--- /dev/null
+++ b/app/src/main/cpp/winlator/winfg/winfg_bridge.cpp
@@ -0,0 +1,372 @@
+// ============================================================================
+// winfg_bridge.cpp — C++ 实现层
+//
+// 内部包装 winfg::FrameGen + 输入 ring buffer（prev/curr 两帧）。
+// dispatch table 从 vortekrenderer 的全局 vulkanWrapper 填充。
+//
+// 参考：Bannerlator 的 winfg_engine.cpp（同为 native 集成范式）。
+// ============================================================================
+#include "winfg_bridge.h"
+#include "framegen.hpp"
+#include "vk_dispatch.hpp"
+#include "config.hpp"
+#include "log.hpp"
+
+// vortekrenderer 的全局 Vulkan 函数指针表（定义在 main.c）
+extern "C" {
+#include "vulkan_wrapper.h"
+extern VulkanWrapper vulkanWrapper;
+}
+
+#include <algorithm>
+#include <cstring>
+
+namespace {
+
+// 2x 时 alpha=0.35（偏向 prev，减少 HUD 重影，与 win-fg layer 一致）
+// 3x/4x 时均匀分布
+float alphaFor(uint32_t k, uint32_t n) {
+    if (n <= 1) return 0.35f;
+    return (float)(k + 1) / (float)(n + 1);
+}
+
+VkImageMemoryBarrier imgBar(VkImage img, VkImageLayout from, VkImageLayout to,
+                            VkAccessFlags src, VkAccessFlags dst) {
+    VkImageMemoryBarrier b{};
+    b.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+    b.oldLayout = from; b.newLayout = to;
+    b.srcAccessMask = src; b.dstAccessMask = dst;
+    b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    b.image = img;
+    b.subresourceRange = VkImageSubresourceRange{VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+    return b;
+}
+
+// 从 vulkanWrapper 填充 win-fg 的 dispatch table
+bool fillDispatch(winfg::DeviceDispatch& dd, winfg::InstanceDispatch& id) {
+    // Instance-level
+    id.GetInstanceProcAddr = vulkanWrapper.vkGetInstanceProcAddr;
+    id.DestroyInstance = vulkanWrapper.vkDestroyInstance;
+    id.GetPhysicalDeviceMemoryProperties = vulkanWrapper.vkGetPhysicalDeviceMemoryProperties;
+    id.GetPhysicalDeviceQueueFamilyProperties = vulkanWrapper.vkGetPhysicalDeviceQueueFamilyProperties;
+    id.GetPhysicalDeviceProperties = vulkanWrapper.vkGetPhysicalDeviceProperties;
+    id.GetPhysicalDeviceProperties2 = vulkanWrapper.vkGetPhysicalDeviceProperties2;
+
+    // Device-level（win-fg chain 实际调用的子集）
+    dd.GetDeviceProcAddr = vulkanWrapper.vkGetDeviceProcAddr;
+    dd.DestroyDevice = vulkanWrapper.vkDestroyDevice;
+    dd.GetDeviceQueue = vulkanWrapper.vkGetDeviceQueue;
+    dd.QueueSubmit = vulkanWrapper.vkQueueSubmit;
+    dd.QueueWaitIdle = vulkanWrapper.vkQueueWaitIdle;
+    dd.DeviceWaitIdle = vulkanWrapper.vkDeviceWaitIdle;
+    dd.CreateImage = vulkanWrapper.vkCreateImage;
+    dd.DestroyImage = vulkanWrapper.vkDestroyImage;
+    dd.CreateImageView = vulkanWrapper.vkCreateImageView;
+    dd.DestroyImageView = vulkanWrapper.vkDestroyImageView;
+    dd.AllocateMemory = vulkanWrapper.vkAllocateMemory;
+    dd.FreeMemory = vulkanWrapper.vkFreeMemory;
+    dd.BindImageMemory = vulkanWrapper.vkBindImageMemory;
+    dd.GetImageMemoryRequirements = vulkanWrapper.vkGetImageMemoryRequirements;
+    dd.CreateBuffer = vulkanWrapper.vkCreateBuffer;
+    dd.DestroyBuffer = vulkanWrapper.vkDestroyBuffer;
+    dd.GetBufferMemoryRequirements = vulkanWrapper.vkGetBufferMemoryRequirements;
+    dd.BindBufferMemory = vulkanWrapper.vkBindBufferMemory;
+    dd.MapMemory = vulkanWrapper.vkMapMemory;
+    dd.UnmapMemory = vulkanWrapper.vkUnmapMemory;
+    dd.CreateSampler = vulkanWrapper.vkCreateSampler;
+    dd.DestroySampler = vulkanWrapper.vkDestroySampler;
+    dd.CreateShaderModule = vulkanWrapper.vkCreateShaderModule;
+    dd.DestroyShaderModule = vulkanWrapper.vkDestroyShaderModule;
+    dd.CreateDescriptorSetLayout = vulkanWrapper.vkCreateDescriptorSetLayout;
+    dd.DestroyDescriptorSetLayout = vulkanWrapper.vkDestroyDescriptorSetLayout;
+    dd.CreatePipelineLayout = vulkanWrapper.vkCreatePipelineLayout;
+    dd.DestroyPipelineLayout = vulkanWrapper.vkDestroyPipelineLayout;
+    dd.CreateComputePipelines = vulkanWrapper.vkCreateComputePipelines;
+    dd.DestroyPipeline = vulkanWrapper.vkDestroyPipeline;
+    dd.CreateDescriptorPool = vulkanWrapper.vkCreateDescriptorPool;
+    dd.DestroyDescriptorPool = vulkanWrapper.vkDestroyDescriptorPool;
+    dd.AllocateDescriptorSets = vulkanWrapper.vkAllocateDescriptorSets;
+    dd.UpdateDescriptorSets = vulkanWrapper.vkUpdateDescriptorSets;
+    dd.ResetDescriptorPool = vulkanWrapper.vkResetDescriptorPool;
+    dd.AllocateCommandBuffers = vulkanWrapper.vkAllocateCommandBuffers;
+    dd.FreeCommandBuffers = vulkanWrapper.vkFreeCommandBuffers;
+    dd.BeginCommandBuffer = vulkanWrapper.vkBeginCommandBuffer;
+    dd.EndCommandBuffer = vulkanWrapper.vkEndCommandBuffer;
+    dd.CmdBindPipeline = vulkanWrapper.vkCmdBindPipeline;
+    dd.CmdBindDescriptorSets = vulkanWrapper.vkCmdBindDescriptorSets;
+    dd.CmdDispatch = vulkanWrapper.vkCmdDispatch;
+    dd.CmdPipelineBarrier = vulkanWrapper.vkCmdPipelineBarrier;
+    dd.CmdCopyImage = vulkanWrapper.vkCmdCopyImage;
+    dd.CmdClearColorImage = vulkanWrapper.vkCmdClearColorImage;
+    dd.CreateFence = vulkanWrapper.vkCreateFence;
+    dd.DestroyFence = vulkanWrapper.vkDestroyFence;
+    dd.WaitForFences = vulkanWrapper.vkWaitForFences;
+    dd.ResetFences = vulkanWrapper.vkResetFences;
+
+    // 校验关键函数非空
+    if (!dd.CreateImage || !dd.CreateImageView || !dd.CreateComputePipelines ||
+        !dd.AllocateMemory || !dd.CmdDispatch || !id.GetPhysicalDeviceMemoryProperties) {
+        WFG_LOGE("bridge: critical Vulkan functions missing in vulkanWrapper");
+        return false;
+    }
+    return true;
+}
+
+struct Slot {
+    VkImage image = VK_NULL_HANDLE;
+    VkDeviceMemory mem = VK_NULL_HANDLE;
+    VkImageView view = VK_NULL_HANDLE;
+    bool valid = false;
+};
+
+} // namespace
+
+// ============================================================================
+// WinFgEngine — 内部实现（C++）
+// ============================================================================
+struct WinFgEngine {
+    winfg::DeviceDispatch dd{};
+    winfg::InstanceDispatch id{};
+    VkPhysicalDevice phys = VK_NULL_HANDLE;
+    VkDevice dev = VK_NULL_HANDLE;
+    uint32_t qf = 0;
+    VkQueue queue = VK_NULL_HANDLE;
+    VkPhysicalDeviceMemoryProperties memProps{};
+
+    winfg::FrameGen fg;
+    winfg::Config cfg;
+    bool unavailable = false;
+
+    Slot ring[2];       // prev/curr 输入 ring
+    int currIdx = 0;    // 当前 curr 在 ring 中的索引
+    uint32_t history = 0;  // 已采集帧数（需2帧才能插值）
+    uint32_t gmSlot = 0;   // C1 global-motion SSBO ring slot
+    uint32_t builtW = 0, builtH = 0;
+    VkFormat builtFmt = VK_FORMAT_UNDEFINED;
+
+    uint32_t memType(uint32_t bits, VkMemoryPropertyFlags props) const {
+        for (uint32_t i = 0; i < memProps.memoryTypeCount; i++)
+            if ((bits & (1u << i)) && (memProps.memoryTypes[i].propertyFlags & props) == props)
+                return i;
+        return 0;
+    }
+
+    bool makeSlot(Slot& s, uint32_t w, uint32_t h, VkFormat fmt) {
+        VkImageCreateInfo ii{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+        ii.imageType = VK_IMAGE_TYPE_2D; ii.extent = VkExtent3D{w, h, 1};
+        ii.mipLevels = 1; ii.arrayLayers = 1; ii.format = fmt;
+        ii.tiling = VK_IMAGE_TILING_OPTIMAL; ii.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+        ii.usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+        ii.samples = VK_SAMPLE_COUNT_1_BIT; ii.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+        if (dd.CreateImage(dev, &ii, nullptr, &s.image) != VK_SUCCESS) return false;
+        VkMemoryRequirements req; dd.GetImageMemoryRequirements(dev, s.image, &req);
+        VkMemoryAllocateInfo ai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+        ai.allocationSize = req.size;
+        ai.memoryTypeIndex = memType(req.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+        if (dd.AllocateMemory(dev, &ai, nullptr, &s.mem) != VK_SUCCESS) { destroySlot(s); return false; }
+        dd.BindImageMemory(dev, s.image, s.mem, 0);
+        VkImageViewCreateInfo vi{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+        vi.image = s.image; vi.viewType = VK_IMAGE_VIEW_TYPE_2D; vi.format = fmt;
+        vi.subresourceRange = VkImageSubresourceRange{VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+        if (dd.CreateImageView(dev, &vi, nullptr, &s.view) != VK_SUCCESS) { destroySlot(s); return false; }
+        s.valid = false;
+        return true;
+    }
+
+    void destroySlot(Slot& s) {
+        if (s.view) dd.DestroyImageView(dev, s.view, nullptr);
+        if (s.image) dd.DestroyImage(dev, s.image, nullptr);
+        if (s.mem) dd.FreeMemory(dev, s.mem, nullptr);
+        s = Slot{};
+    }
+
+    void destroyRing() {
+        if (dev == VK_NULL_HANDLE || !dd.DeviceWaitIdle) return;
+        if (ring[0].image || ring[1].image) dd.DeviceWaitIdle(dev);
+        destroySlot(ring[0]); destroySlot(ring[1]);
+        history = 0;
+    }
+};
+
+// ============================================================================
+// C 接口实现
+// ============================================================================
+
+extern "C" WinFgEngine* winfg_create(VkInstance /*instance*/,
+                                      VkPhysicalDevice phys,
+                                      VkDevice dev,
+                                      uint32_t queueFamily,
+                                      VkQueue queue) {
+    auto* e = new WinFgEngine();
+    e->phys = phys; e->dev = dev; e->qf = queueFamily; e->queue = queue;
+
+    if (!fillDispatch(e->dd, e->id)) {
+        WFG_LOGE("bridge: dispatch fill failed");
+        delete e;
+        return nullptr;
+    }
+    e->id.GetPhysicalDeviceMemoryProperties(phys, &e->memProps);
+
+    if (!e->fg.init(&e->dd, &e->id, phys, dev, queueFamily, queue)) {
+        WFG_LOGE("bridge: FrameGen::init failed");
+        e->unavailable = true;
+        delete e;
+        return nullptr;
+    }
+    WFG_LOGI("bridge: win-fg native engine ready (10 pipelines, embedded shaders)");
+    return e;
+}
+
+extern "C" void winfg_configure(WinFgEngine* e, int multiplier, int model,
+                                 int perfPreset, float flowScale) {
+    if (!e || e->unavailable) return;
+    e->cfg.enabled = true;
+    e->cfg.multiplier = std::max(2, multiplier);
+    e->cfg.model = (model == 3) ? 3 : 4;
+    e->cfg.perfPreset = std::clamp(perfPreset, 0, 2);
+    e->cfg.flowScale = std::clamp(flowScale, 0.25f, 1.0f);
+    e->fg.configure(e->cfg);
+}
+
+extern "C" bool winfg_prepare(WinFgEngine* e, uint32_t w, uint32_t h, VkFormat fmt) {
+    if (!e || e->unavailable || w == 0 || h == 0 || fmt == VK_FORMAT_UNDEFINED) return false;
+    if (e->builtW == w && e->builtH == h && e->builtFmt == fmt && e->fg.valid()) return true;
+
+    if (!e->fg.onResize(VkExtent2D{w, h}, fmt, false)) {
+        WFG_LOGE("bridge: onResize %ux%u failed", w, h);
+        e->unavailable = true;
+        return false;
+    }
+    e->destroyRing();
+    for (Slot& s : e->ring) {
+        if (!e->makeSlot(s, w, h, fmt)) { e->destroyRing(); e->unavailable = true; return false; }
+    }
+    e->builtW = w; e->builtH = h; e->builtFmt = fmt;
+    e->history = 0; e->currIdx = 0;
+    WFG_LOGI("bridge: prepared %ux%u fmt=%d model=%d preset=%d",
+             w, h, (int)fmt, e->cfg.model, e->cfg.perfPreset);
+    return true;
+}
+
+extern "C" uint32_t winfg_process(WinFgEngine* e, VkCommandBuffer cmd,
+                                   VkImage source, uint32_t w, uint32_t h) {
+    if (!e || e->unavailable || !e->fg.valid()) return 0;
+
+    // 旋转 ring：要覆盖的 slot 变为新 curr，另一个变为 prev
+    e->currIdx = 1 - e->currIdx;
+    Slot& dst = e->ring[e->currIdx];
+
+    // source GENERAL → TRANSFER_SRC；dst UNDEFINED → TRANSFER_DST
+    VkImageMemoryBarrier pre[2] = {
+        imgBar(source, VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+               VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_SHADER_WRITE_BIT,
+               VK_ACCESS_TRANSFER_READ_BIT),
+        imgBar(dst.image, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+               0, VK_ACCESS_TRANSFER_WRITE_BIT),
+    };
+    e->dd.CmdPipelineBarrier(cmd,
+        VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+        VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 2, pre);
+
+    VkImageCopy region{};
+    region.srcSubresource = VkImageSubresourceLayers{VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    region.dstSubresource = VkImageSubresourceLayers{VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    region.extent = VkExtent3D{w, h, 1};
+    e->dd.CmdCopyImage(cmd, source, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                       dst.image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+
+    // source → GENERAL（恢复）；dst → SHADER_READ_ONLY（chain 采样用）
+    VkImageMemoryBarrier post[2] = {
+        imgBar(source, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_IMAGE_LAYOUT_GENERAL,
+               VK_ACCESS_TRANSFER_READ_BIT,
+               VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_TRANSFER_READ_BIT),
+        imgBar(dst.image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+               VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_SHADER_READ_BIT),
+    };
+    e->dd.CmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT,
+        VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT,
+        0, 0, nullptr, 0, nullptr, 2, post);
+
+    dst.valid = true;
+    if (e->history < 2) e->history++;
+
+    // 返回应生成的帧数
+    if (e->history < 2) return 0;
+    uint32_t want = (uint32_t)std::max(e->cfg.multiplier - 1, 0);
+    return std::min(want, 3u);  // 最多3帧（4x）
+}
+
+extern "C" void winfg_generate(WinFgEngine* e, VkCommandBuffer cmd,
+                                uint32_t generation, uint32_t count,
+                                VkImage targetImage, VkImageView targetView,
+                                uint32_t /*w*/, uint32_t /*h*/) {
+    if (!e || e->unavailable || e->history < 2 || !e->fg.valid()) return;
+    const Slot& prev = e->ring[1 - e->currIdx];
+    const Slot& curr = e->ring[e->currIdx];
+    if (!prev.valid || !curr.valid) return;
+
+    // target GENERAL → GENERAL（为 compute write 做准备）
+    VkImageMemoryBarrier toWrite = imgBar(targetImage, VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_GENERAL,
+        VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_SHADER_READ_BIT, VK_ACCESS_SHADER_WRITE_BIT);
+    e->dd.CmdPipelineBarrier(cmd,
+        VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+        VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 0, nullptr, 0, nullptr, 1, &toWrite);
+
+    e->fg.record(cmd, prev.view, curr.view, targetView,
+                 alphaFor(generation, count), e->gmSlot);
+    if (generation + 1 == count)
+        e->gmSlot = (e->gmSlot + 1) % (uint32_t)winfg::FrameGen::kGmSlots;
+}
+
+extern "C" void winfg_restore_curr(WinFgEngine* e, VkCommandBuffer cmd,
+                                    VkImage target, uint32_t w, uint32_t h) {
+    if (!e || e->unavailable) return;
+    const Slot& curr = e->ring[e->currIdx];
+    if (!curr.valid) return;
+
+    // curr SHADER_READ_ONLY → TRANSFER_SRC；target GENERAL → TRANSFER_DST
+    VkImageMemoryBarrier pre[2] = {
+        imgBar(curr.image, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+               VK_ACCESS_SHADER_READ_BIT, VK_ACCESS_TRANSFER_READ_BIT),
+        imgBar(target, VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+               VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_READ_BIT, VK_ACCESS_TRANSFER_WRITE_BIT),
+    };
+    e->dd.CmdPipelineBarrier(cmd,
+        VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT,
+        VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 2, pre);
+
+    VkImageCopy region{};
+    region.srcSubresource = VkImageSubresourceLayers{VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    region.dstSubresource = VkImageSubresourceLayers{VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    region.extent = VkExtent3D{w, h, 1};
+    e->dd.CmdCopyImage(cmd, curr.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                       target, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+
+    // curr → SHADER_READ_ONLY；target → GENERAL
+    VkImageMemoryBarrier post[2] = {
+        imgBar(curr.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+               VK_ACCESS_TRANSFER_READ_BIT, VK_ACCESS_SHADER_READ_BIT),
+        imgBar(target, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_GENERAL,
+               VK_ACCESS_TRANSFER_WRITE_BIT,
+               VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_TRANSFER_READ_BIT),
+    };
+    e->dd.CmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT,
+        VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT,
+        0, 0, nullptr, 0, nullptr, 2, post);
+}
+
+extern "C" void winfg_reset(WinFgEngine* e) {
+    if (!e) return;
+    e->history = 0;
+}
+
+extern "C" void winfg_destroy(WinFgEngine* e) {
+    if (!e) return;
+    e->destroyRing();
+    e->fg.destroy();
+    delete e;
+}
+
+extern "C" bool winfg_valid(WinFgEngine* e) {
+    return e && !e->unavailable && e->fg.valid();
+}
diff --git a/app/src/main/cpp/winlator/winfg/winfg_bridge.h b/app/src/main/cpp/winlator/winfg/winfg_bridge.h
new file mode 100644
index 0000000..a292ab3
--- /dev/null
+++ b/app/src/main/cpp/winlator/winfg/winfg_bridge.h
@@ -0,0 +1,90 @@
+// ============================================================================
+// winfg_bridge.h — C 接口层
+//
+// Why: vortekrenderer 是纯 C 项目，而 win-fg (framegen.cpp) 是 C++。
+//      本文件提供纯 C 接口，内部用 C++ 包装 winfg::FrameGen + 输入 ring。
+// What: 暴露 init/configure/prepare/process/generate/restore/reset/destroy。
+// How: 删除本文件及 winfg_bridge.cpp、winfg/ 目录即回退到无帧生成版本。
+//
+// 集成位置：xwindow_swapchain.c 的 XWindowSwapchain_presentImage()。
+// ============================================================================
+#ifndef WINFG_BRIDGE_H
+#define WINFG_BRIDGE_H
+
+#include <vulkan/vulkan.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct WinFgEngine WinFgEngine;
+
+// 创建并初始化帧生成引擎。
+// instance/phys/dev/queueFamily/queue 来自 vortekrenderer 的 Vulkan 上下文。
+// 失败返回 NULL（logcat tag "win-fg" 有详细原因）。
+WinFgEngine* winfg_create(VkInstance instance,
+                          VkPhysicalDevice phys,
+                          VkDevice dev,
+                          uint32_t queueFamily,
+                          VkQueue queue);
+
+// 运行时配置（热更新，无需重启）。
+//   multiplier: 2/3/4（生成帧数 = multiplier-1）
+//   model:      3=optical flow, 4=bidirectional（默认4）
+//   perfPreset: 0=质量, 1=平衡（默认）, 2=性能
+//   flowScale:  光流幅度缩放（0.25~1.0，默认1.0）
+void winfg_configure(WinFgEngine* e,
+                     int multiplier,
+                     int model,
+                     int perfPreset,
+                     float flowScale);
+
+// 准备指定分辨率/格式的资源。分辨率变化时必须调用。
+bool winfg_prepare(WinFgEngine* e, uint32_t w, uint32_t h, VkFormat fmt);
+
+// 处理一帧：把 source 复制到内部 ring 作为 "curr"（上一帧自动变为 "prev"）。
+// 返回本次应生成的中间帧数（0=还没有 prev 帧或引擎无效，1=2x，2=3x，3=4x）。
+// 调用者需在调用前后自行管理 source 的 image layout（GENERAL 进出）。
+uint32_t winfg_process(WinFgEngine* e,
+                       VkCommandBuffer cmd,
+                       VkImage source,
+                       uint32_t w,
+                       uint32_t h);
+
+// 生成第 generation 帧（共 count 帧）到 targetImage/targetView。
+// generation: 0..count-1；count 通常 = winfg_process 的返回值。
+// target 必须是 GENERAL layout（进出都是 GENERAL）。
+void winfg_generate(WinFgEngine* e,
+                    VkCommandBuffer cmd,
+                    uint32_t generation,
+                    uint32_t count,
+                    VkImage targetImage,
+                    VkImageView targetView,
+                    uint32_t w,
+                    uint32_t h);
+
+// 把内部 ring 的 "curr"（最近一次 process 的真实帧）blit 到 target。
+// 用于生成帧显示后恢复 swapchain image 为真实帧。
+// target 必须是 GENERAL layout（进出都是 GENERAL）。
+void winfg_restore_curr(WinFgEngine* e,
+                        VkCommandBuffer cmd,
+                        VkImage target,
+                        uint32_t w,
+                        uint32_t h);
+
+// 重置历史（清除 prev 帧，下一帧重新开始采集）。
+void winfg_reset(WinFgEngine* e);
+
+// 销毁引擎及所有资源。
+void winfg_destroy(WinFgEngine* e);
+
+// 引擎是否有效（init 成功且未失败）。
+bool winfg_valid(WinFgEngine* e);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // WINFG_BRIDGE_H
