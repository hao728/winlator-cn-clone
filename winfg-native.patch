+    if (g_winfgEnabled != swapchain->winfgEnabled ||
+        g_winfgMultiplier != swapchain->winfgMultiplier ||
+        g_winfgModel != swapchain->winfgModel ||
+        g_winfgPreset != swapchain->winfgPreset ||
+        g_winfgFlowScale != swapchain->winfgFlowScale) {
+        swapchain->winfgEnabled = g_winfgEnabled;
+        swapchain->winfgMultiplier = g_winfgMultiplier;
+        swapchain->winfgModel = g_winfgModel;
+        swapchain->winfgPreset = g_winfgPreset;
+        swapchain->winfgFlowScale = g_winfgFlowScale;
