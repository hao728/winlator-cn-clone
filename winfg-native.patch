+                // cmd 资源创建失败，回退到普通 present
+                (*swapchain->jmethods->env)->CallVoidMethod(swapchain->jmethods->env, swapchain->jmethods->obj,
+                                                            swapchain->jmethods->updateWindowContent, swapchain->windowId);
+                return;
+            }
+            swapchain->winfgEngine = winfg_create(VK_NULL_HANDLE, swapchain->phys, swapchain->device,
+                                                   swapchain->queueFamily, swapchain->queue);
+            if (!swapchain->winfgEngine) {
+                // engine 创建失败，禁用 win-fg
+                swapchain->winfgEnabled = 0;
+                (*swapchain->jmethods->env)->CallVoidMethod(swapchain->jmethods->env, swapchain->jmethods->obj,
+                                                            swapchain->jmethods->updateWindowContent, swapchain->windowId);
+                return;
+            }
+            winfg_configure((WinFgEngine*)swapchain->winfgEngine,
+                            swapchain->winfgMultiplier, swapchain->winfgModel,
+                            swapchain->winfgPreset, swapchain->winfgFlowScale);
+        }
+
+        uint32_t w = swapchain->imageExtent.width;
+        uint32_t h = swapchain->imageExtent.height;
+        VkFormat fmt = swapchain->imageFormat;
+
+        // 准备分辨率
+        if (!winfg_prepare((WinFgEngine*)swapchain->winfgEngine, w, h, fmt)) {
+            (*swapchain->jmethods->env)->CallVoidMethod(swapchain->jmethods->env, swapchain->jmethods->obj,
+                                                        swapchain->jmethods->updateWindowContent, swapchain->windowId);
+            return;
+        }
+
+        // 确保 genImage
