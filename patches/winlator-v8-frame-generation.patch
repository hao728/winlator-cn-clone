+        if (refreshRate != displayRefreshRate) {
+            displayRefreshRate = refreshRate;
+            calculateDisplayCounts();
+            LogString("Display refresh rate set to: " + refreshRate + " Hz");
+        }
+    }
+
+    public int getInitialFPS() {
